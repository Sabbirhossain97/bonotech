PORT=8792
HOST=127.0.0.1
NODE_ENV=production

# Comma-separated browser origins allowed to call this API
ALLOWED_ORIGINS=https://bonotech.io,https://www.bonotech.io,https://bonotech-website.web.app,https://bonotech-website.firebaseapp.com,http://localhost:5174,http://localhost:5173

# Only these addresses may appear in the request recipient list
ALLOWED_RECIPIENTS=ekram@edutechs.app,humaira@di.vc,contact@bonotech.io

# Gmail (App Password) — or set SMTP_* below instead
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Bonotech Website

# Optional generic SMTP (used when GMAIL_USER is empty)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@bonotech.io
